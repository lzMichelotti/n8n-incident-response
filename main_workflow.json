    {
      "parameters": {
        "jsCode": "// Node: Code (Simulação/Normalização) - UPDATED\n// Linguagem: JavaScript\n\n// Obtém todos os itens de entrada\nconst items = $input.all();\nconst entradaItem = items[0]; // Pega o primeiro item de entrada\n\nlet dados;\n\n// Verifica se a entrada é um objeto e se tem uma propriedade 'json'\n// e se dentro de 'json' existe um 'body' (Webhook POST)\nif (entradaItem && typeof entradaItem.json === 'object' && entradaItem.json.body) {\n  dados = entradaItem.json.body;\n} else if (entradaItem && typeof entradaItem.json === 'object') {\n  // Se não tiver 'body', assume que o JSON é a entrada direta\n  dados = entradaItem.json;\n} else {\n  // Fallback caso a estrutura seja inesperada\n  dados = {};\n}\n\n// Monta o objeto simulado garantindo que os campos existam\nconst output = {\n  server_name: dados.server || \"srv-unknown-01\",\n  description: dados.description || \"Alerta de Monitoramento\",\n\n  // Converte para Inteiro para a regra > 90 funcionar\n  memory_usage: parseInt(dados.memory_usage || 0),\n\n  // Passa os outros campos se existirem\n  commit: dados.commit || null,\n  id: dados.id || null\n};\n\nreturn [{ json: output }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        592
      ],
      "id": "220552e2-6d09-4bbe-a091-364b307b1bdd",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "const inputData = $input.all()[0].json;\n\n// Separar o que veio do Webhook (Alerta) do que veio do GitHub (Contexto)\n\nconst promptFinal = `\nVocê é um Gerente de SRE Sênior.\n\nANALISE DO INCIDENTE:\n---------------------------------------------------\nTÍTULO: ${inputData.alert_name}\nSEVERIDADE: ${inputData.severity}\nDESCRIÇÃO DO PROBLEMA: ${inputData.description}\n---------------------------------------------------\n\nCONTEXTO DO AMBIENTE (Último Deploy Detectado):\n*Commit Message:* ${inputData.commit?.message || \"Nenhum commit recente detectado\"}\n*Autor:* ${inputData.commit?.author?.name || \"N/A\"}\n\nREGRAS DE DECISÃO:\n1. INFRAESTRUTURA (Ação: RESTART)\n   - Problemas de hardware, memória estourada, disco cheio ou processos travados.\n   - IGNORE o commit se o erro for claramente de recurso de máquina.\n\n2. SOFTWARE (Ação: BUG_REPORT)\n   - Erros de lógica, cálculo errado, layout quebrado ou falhas logo após o deploy.\n   - Use o contexto do commit para confirmar se foi uma mudança recente que quebrou.\n\n3. CRÍTICO/HUMANO (Ação: ESCALATE)\n   - Segurança, Ransomware, Fraude ou Perda Financeira.\n   - Situações onde reiniciar ou abrir ticket é insuficiente.\n\nResponda APENAS o JSON:\n{ \"reasoning\": \"...\", \"action\": \"...\" }\n`;\n\nreturn [{ json: { meu_prompt: promptFinal } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        608,
        304
      ],
      "id": "7c9ae185-4ef5-4c26-96c2-3a96f93f5669",
      "name": "Code in JavaScript1"
    },
    {
      "parameters": {
        "jsCode": "// Node: Code2 (Parse da Resposta da IA)\n// Linguagem: JavaScript\n\n// Resposta da IA\nconst textoDaIa = $input.all()[0].json.output;\n\n// Remove blocos de código markdown (```json ... ```)\nconst textoLimpo = textoDaIa.replace(/```json|```/g, \"\").trim();\n\nlet decisaoLimpa;\n\n// Tenta fazer o parse. Se falhar, cria um fallback para não parar o fluxo\ntry {\n  decisaoLimpa = JSON.parse(textoLimpo);\n} catch (error) {\n  // Se a IA alucinar e não mandar JSON, forçamos um Bug Report para analisar depois\n  decisaoLimpa = {\n    reasoning: \"Falha no parse da resposta da IA. Texto original: \" + textoDaIa,\n    action: \"BUG_REPORT\",\n    confidence: 0\n  };\n}\n\n// Adiciona o server_name original que veio do input para não perdê-lo\ndecisaoLimpa.server_name = $input.all()[0].json.server_name || \"srv-unknown\";\n\nreturn [{ json: decisaoLimpa }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1184,
        304
      ],
