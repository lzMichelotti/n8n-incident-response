    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO incident_logs (server_name, action_taken, reasoning, confidence)\nVALUES (\n  '{{ $json.server_name || \"web-prod-01\" }}',\n  '{{ $json.action }}',\n  '{{ $json.reasoning.replace(/'/g, \"\") }}', \n  {{ $json.confidence || 0 }}\n);",
        "options": {}
